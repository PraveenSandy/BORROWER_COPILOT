{
  "name": "borrower-copilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "report": "esbuild tools/print-report.ts --bundle --platform=node --format=esm --outfile=.tmp/print-report.mjs --log-level=error && node .tmp/print-report.mjs",
    "questions": "esbuild tools/print-question-paths.ts --bundle --platform=node --format=esm --outfile=.tmp/print-question-paths.mjs --log-level=error && node .tmp/print-question-paths.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
